<odoo>

<record id="create_employee_external_assignment_view_form" model="ir.ui.view">
    <field name="name">create_employee_external_assignment: Operating Unit Form</field>
    <field name="model">create_employee_external_assignment</field>
    <field
            name="inherit_id"
            ref="ssi_employee_external_assignment_agreement.create_employee_external_assignment_view_form"
        />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='agreement_id']" position="after">
                <field
                        name="operating_unit_id"
                        groups="operating_unit.group_multi_operating_unit"
                    />
            </xpath>
        </data>
    </field>
</record>

</odoo>
