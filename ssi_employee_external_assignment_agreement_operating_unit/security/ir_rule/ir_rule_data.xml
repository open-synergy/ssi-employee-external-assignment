<odoo>
<record id="employee_external_assignment_agreement_rule_ou" model="ir.rule">
    <field
            name="name"
        >employee_external_assignment_agreement - Responsible to operating unit data</field>
    <field
            name="model_id"
            ref="ssi_employee_external_assignment_agreement.model_employee_external_assignment_agreement"
        />
    <field
            name="groups"
            eval="[(4, ref('employee_external_assignment_agreement_ou_group'))]"
        />
    <field
            name="domain_force"
        >[('operating_unit_id','in',[g.id for g in user.operating_unit_ids])]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>

<record
        id="employee_external_assignment_agreement_payment_term_rule_ou"
        model="ir.rule"
    >
    <field
            name="name"
        >employee_external_assignment_agreement.payment_term - Responsible to operating unit data</field>
    <field
            name="model_id"
            ref="ssi_employee_external_assignment_agreement.model_employee_external_assignment_agreement_payment_term"
        />
    <field
            name="groups"
            eval="[(4, ref('employee_external_assignment_agreement_payment_term_ou_group'))]"
        />
    <field
            name="domain_force"
        >[('operating_unit_id','in',[g.id for g in user.operating_unit_ids])]</field>
    <field name="perm_unlink" eval="1" />
    <field name="perm_write" eval="1" />
    <field name="perm_read" eval="1" />
    <field name="perm_create" eval="1" />
</record>
</odoo>
