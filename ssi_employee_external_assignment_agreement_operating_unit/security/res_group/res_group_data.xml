    <field
            name="category_id"
            ref="ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_batch_data_ownership"
        />
</record>

<record
        id="ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_batch_company_group"
        model="res.groups"
    >
    <field name="name">Company</field>
    <field
            name="category_id"
            ref="ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_batch_data_ownership"
        />
    <field
            name="implied_ids"
