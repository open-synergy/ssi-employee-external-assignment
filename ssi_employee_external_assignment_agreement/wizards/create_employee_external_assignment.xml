<odoo>

<record id="create_employee_external_assignment_view_form" model="ir.ui.view">
    <field name="name">create_employee_external_assignment - form</field>
    <field name="model">create_employee_external_assignment</field>
    <field name="arch" type="xml">
        <form>
            <field name="allowed_employee_ids" invisible="1" />
            <group name="group_1" colspan="4" col="2">
                <field name="agreement_id" invisible="0" />
                <field
                        name="employee_ids"
                        widget="many2many_tags"
                        domain="[('id','in',allowed_employee_ids)]"
                    />
            </group>
            <footer>
                <button
                        string="Confirm"
                        name="action_create_assignment"
                        type="object"
                        class="oe_highlight"
                        confirm="Are you sure?"
                    />
                or
                <button string="Cancel" class="oe_link" special="cancel" />
            </footer>
        </form>
    </field>
</record>

<record id="create_employee_external_assignment_action" model="ir.actions.act_window">
    <field name="name">Create Employee External Assignment</field>
    <field name="res_model">create_employee_external_assignment</field>
    <field name="view_mode">form</field>
    <field name="view_id" ref="create_employee_external_assignment_view_form" />
    <field name="target">new</field>
</record>

</odoo>
