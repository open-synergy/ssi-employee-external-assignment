<odoo>
    <data>
        <record id="employee_external_assignment_view_tree" model="ir.ui.view">
            <field name="name">employee_external_assignment - tree</field>
            <field name="model">employee_external_assignment</field>
            <field
                name="inherit_id"
                ref="ssi_employee_external_assignment.employee_external_assignment_view_tree"
            />
            <field name="mode">extension</field>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='partner_id']" position="after">
                        <field name="agreement_id" />
                    </xpath>
                </data>
            </field>
        </record>

        <!-- E.9: Form view (inherits transaction mixin form) -->
        <record id="employee_external_assignment_view_form" model="ir.ui.view">
            <field name="name">employee_external_assignment - form</field>
            <field name="model">employee_external_assignment</field>
            <field
                name="inherit_id"
                ref="ssi_employee_external_assignment.employee_external_assignment_view_form"
            />
            <field name="mode">extension</field>
            <field name="arch" type="xml">
                <data>
                    <xpath
                        expr="//field[@name='partner_location_id']"
                        position="before"
                    >
                        <field name="agreement_id" />
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>
