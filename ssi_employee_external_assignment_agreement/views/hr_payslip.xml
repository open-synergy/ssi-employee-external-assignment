<odoo>
    <data>
        <record id="hr_payslip_view_form" model="ir.ui.view">
            <field
                name="name"
            >hr.payslip - form - employee external assignment agreement</field>
            <field name="model">hr.payslip</field>
            <field name="mode">extension</field>
            <field name="inherit_id" ref="ssi_hr_payroll.hr_payslip_view_form" />
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='job_id']" position="after">
                        <field name="agreement_payment_term_id" />
                        <field name="agreement_id" readonly="1" force_save="1" />
                    </xpath>
                </data>
            </field>
        </record>
    </data>
</odoo>
