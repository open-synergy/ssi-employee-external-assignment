<odoo noupdate="0">
    <data>
        <record
            id="sequence_template_employee_external_assignment_agreement_batch"
            model="sequence.template"
        >
            <field name="name">Standard</field>
            <field
                name="model_id"
                ref="model_employee_external_assignment_agreement_batch"
            />
            <field name="sequence" eval="100" />
            <field name="initial_string">/</field>
            <field
                name="sequence_field_id"
                search="[('model_id.model','=','employee_external_assignment_agreement_batch'),('name','=','name')]"
            />
            <field
                name="date_field_id"
                search="[('model_id.model','=','employee_external_assignment_agreement_batch'),('name','=','date')]"
            />
            <field name="computation_method">use_python</field>
            <field name="python_code">result=True</field>
            <field
                name="sequence_id"
                ref="ssi_employee_external_assignment_agreement.sequence_employee_external_assignment_agreement_batch"
            />
            <field name="sequence_selection_method">use_sequence</field>
            <field name="add_custom_prefix" eval="0" />
            <field name="add_custom_suffix" eval="0" />
        </record>
    </data>
</odoo>
