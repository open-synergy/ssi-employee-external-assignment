<odoo noupdate="0">
    <data>
        <record
            id="employee_external_assignment_agreement_payment_term_internal_user_rule"
            model="ir.rule"
        >
            <field
                name="name"
            >employee_external_assignment_agreement.payment_term - Internal User</field>
            <field
                name="model_id"
                ref="model_employee_external_assignment_agreement_payment_term"
            />
            <field name="domain_force">[("user_id", "=", user.id)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]" />
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="1" />
        </record>
        <record
            id="employee_external_assignment_agreement_payment_term_company_rule"
            model="ir.rule"
        >
            <field
                name="name"
            >employee_external_assignment_agreement.payment_term - Responsible to company data</field>
            <field
                name="model_id"
                ref="model_employee_external_assignment_agreement_payment_term"
            />
            <field name="domain_force">[("company_id", "=", user.company_id.id)]</field>
            <field
                name="groups"
                eval="[(4, ref('ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_payment_term_company_group'))]"
            />
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="1" />
        </record>
        <record
            id="employee_external_assignment_agreement_payment_term_child_company_rule"
            model="ir.rule"
        >
            <field
                name="name"
            >employee_external_assignment_agreement.payment_term - Responsible to company and all child companies data</field>
            <field
                name="model_id"
                ref="model_employee_external_assignment_agreement_payment_term"
            />
            <field
                name="domain_force"
            >[("company_id", "in", user.company_ids.ids)]</field>
            <field
                name="groups"
                eval="[(4, ref('ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_payment_term_child_company_group'))]"
            />
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="1" />
        </record>
        <record
            id="employee_external_assignment_agreement_payment_term_all_rule"
            model="ir.rule"
        >
            <field
                name="name"
            >employee_external_assignment_agreement.payment_term - Responsible to all data</field>
            <field
                name="model_id"
                ref="model_employee_external_assignment_agreement_payment_term"
            />
            <field name="domain_force">[(1, "=", 1)]</field>
            <field
                name="groups"
                eval="[(4, ref('ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_payment_term_all'))]"
            />
            <field name="perm_read" eval="1" />
            <field name="perm_write" eval="1" />
            <field name="perm_create" eval="1" />
            <field name="perm_unlink" eval="1" />
        </record>
    </data>
</odoo>
