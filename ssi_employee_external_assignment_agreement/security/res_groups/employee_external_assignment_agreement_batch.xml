<odoo noupdate="0">
    <data>
        <!-- Workflow groups -->
        <record
            id="employee_external_assignment_agreement_batch_viewer_group"
            model="res.groups"
        >
            <field name="name">Viewer</field>
            <field
                name="category_id"
                ref="ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_batch_workflow"
            />
        </record>
        <record
            id="employee_external_assignment_agreement_batch_user_group"
            model="res.groups"
        >
            <field name="name">User</field>
            <field
                name="category_id"
                ref="ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_batch_workflow"
            />
            <field
                name="implied_ids"
                eval="[(4, ref('employee_external_assignment_agreement_batch_viewer_group'))]"
            />
        </record>
        <record
            id="employee_external_assignment_agreement_batch_validator_group"
            model="res.groups"
        >
            <field name="name">Validator</field>
            <field
                name="category_id"
                ref="ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_batch_workflow"
            />
            <field
                name="implied_ids"
                eval="[(4, ref('employee_external_assignment_agreement_batch_user_group'))]"
            />
            <field
                name="users"
                eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
            />
        </record>

        <!-- Data ownership groups -->
        <record
            id="employee_external_assignment_agreement_batch_company_group"
            model="res.groups"
        >
            <field name="name">Company</field>
            <field
                name="category_id"
                ref="ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_batch_data_ownership"
            />
        </record>
        <record
            id="employee_external_assignment_agreement_batch_child_company_group"
            model="res.groups"
        >
            <field name="name">Company and All Child Companies</field>
            <field
                name="category_id"
                ref="ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_batch_data_ownership"
            />
            <field
                name="implied_ids"
                eval="[(4, ref('employee_external_assignment_agreement_batch_company_group'))]"
            />
        </record>
        <record
            id="employee_external_assignment_agreement_batch_all"
            model="res.groups"
        >
            <field name="name">All</field>
            <field
                name="category_id"
                ref="ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_batch_data_ownership"
            />
            <field
                name="implied_ids"
                eval="[(4, ref('employee_external_assignment_agreement_batch_child_company_group'))]"
            />
            <field
                name="users"
                eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
            />
        </record>
    </data>
</odoo>
