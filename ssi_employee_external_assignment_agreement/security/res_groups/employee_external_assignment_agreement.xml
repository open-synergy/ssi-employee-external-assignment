<odoo noupdate="0">
    <data>
        <record
            id="employee_external_assignment_agreement_input_type_configurator_group"
            model="res.groups"
        >
            <field name="name">External Assignment Agreement Input Type</field>
            <field
                name="category_id"
                ref="ssi_hr.human_resource_configurator_module_category"
            />
            <field
                name="users"
                eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
            />
        </record>

        <!-- Workflow groups -->
        <record
            id="employee_external_assignment_agreement_viewer_group"
            model="res.groups"
        >
            <field name="name">Viewer</field>
            <field
                name="category_id"
                ref="ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_workflow"
            />
        </record>
        <record
            id="employee_external_assignment_agreement_user_group"
            model="res.groups"
        >
            <field name="name">User</field>
            <field
                name="category_id"
                ref="ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_workflow"
            />
            <field
                name="implied_ids"
                eval="[(4, ref('employee_external_assignment_agreement_viewer_group'))]"
            />
        </record>
        <record
            id="employee_external_assignment_agreement_validator_group"
            model="res.groups"
        >
            <field name="name">Validator</field>
            <field
                name="category_id"
                ref="ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_workflow"
            />
            <field
                name="implied_ids"
                eval="[(4, ref('employee_external_assignment_agreement_user_group'))]"
            />
            <field
                name="users"
                eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
            />
        </record>

        <!-- Data ownership groups -->
        <record
            id="employee_external_assignment_agreement_company_group"
            model="res.groups"
        >
            <field name="name">Company</field>
            <field
                name="category_id"
                ref="ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_data_ownership"
            />
        </record>
        <record
            id="employee_external_assignment_agreement_child_company_group"
            model="res.groups"
        >
            <field name="name">Company and All Child Companies</field>
            <field
                name="category_id"
                ref="ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_data_ownership"
            />
            <field
                name="implied_ids"
                eval="[(4, ref('employee_external_assignment_agreement_company_group'))]"
            />
        </record>
        <record id="employee_external_assignment_agreement_all" model="res.groups">
            <field name="name">All</field>
            <field
                name="category_id"
                ref="ssi_employee_external_assignment_agreement.employee_external_assignment_agreement_data_ownership"
            />
            <field
                name="implied_ids"
                eval="[(4, ref('employee_external_assignment_agreement_company_group'))]"
            />
            <field
                name="users"
                eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
            />
        </record>
    </data>
</odoo>
